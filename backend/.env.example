# Workshop Parts Desk - Environment Configuration
APP_NAME="Workshop Parts Desk"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./workshop.db

# LLM Configuration
# Modes: "mock" (offline deterministic) or "live" (OpenAI API)
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Tool Mode: "mock" or "live"
TOOL_MODE=mock

# Budget and Spending Limits (in USD, leave empty or 0 for unconstrained)
TOTAL_BUDGET_LIMIT=5.00
MAX_LLM_SPENDING=3.00
MAX_TOOL_SPENDING=2.00
